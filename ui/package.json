{
  "name": "ui",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "start": "vite --port $UI_PORT --clearScreen false",
    "build": "vite build",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run src/search/perf.test.ts",
    "test:e2e": "playwright test",
    "package": "rimraf dist && rimraf dist.zip && npm run build && cd dist && bestzip ../dist.zip *"
  },
  "dependencies": {
    "@holo-host/identicon": "^0.1.0",
    "@holochain-open-dev/elements": "^0.700.0",
    "@holochain-open-dev/file-storage": "0.700.0-dev.0",
    "@holochain-open-dev/profiles": "^0.701.0",
    "@holochain/client": "^0.21.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@theweave/api": "0.7.0-dev.1",
    "diff": "^5.2.0",
    "dompurify": "^3.4.13",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "minisearch": "^7.1.0",
    "turndown": "^7.1.3",
    "turndown-plugin-gfm": "^1.0.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tsconfig/svelte": "^5.0.0",
    "@types/diff": "^5.2.0",
    "@types/js-yaml": "^4.0.9",
    "@types/turndown": "^5.0.4",
    "@types/uuid": "^10.0.0",
    "bestzip": "^2.2.0",
    "jsdom": "^24.0.0",
    "rimraf": "^3.0.2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.4.1",
    "typescript": "^5.8.3",
    "vite": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
